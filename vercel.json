{
  "routes": [
    {
      "src": "/.well-known/apple-app-site-association",
      "dest": "/api/aasa"
    },
    {
      "src": "/api/s/([^/]+)",
      "dest": "/api/s/[code].js?code=$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/api/roster/([^/]+)",
      "dest": "/api/roster/[id].js?id=$1"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
